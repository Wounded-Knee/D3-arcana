DATABASE_URL=
# Optional override for automated tests (defaults to DATABASE_URL when unset)
TEST_DATABASE_URL=
# Optional test database name used by scripts/setup-test-db.sh
TEST_DB_NAME=d3_arcana_test
PORT=3000

# Development-only opaque bearer tokens mapped to user UUIDs (token:userId pairs).
# Run `pnpm --filter server db:seed` to generate values for Alice/Bob fixtures.
# Example: DEV_AUTH_TOKENS=dev-alice:<uuid>,dev-bob:<uuid>
DEV_AUTH_TOKENS=
