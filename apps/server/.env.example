DATABASE_URL=
# Optional override for automated tests (defaults to DATABASE_URL when unset)
TEST_DATABASE_URL=
# Optional test database name used by scripts/setup-test-db.sh
TEST_DB_NAME=d3_arcana_test
PORT=3000

# Development-only opaque bearer tokens mapped to user UUIDs (token:userId pairs).
# Run `pnpm --filter server db:seed` to generate values for Alice/Bob fixtures.
# Example: DEV_AUTH_TOKENS=dev-alice:<uuid>,dev-bob:<uuid>
DEV_AUTH_TOKENS=

# LiveKit (self-hosted dev — keys match docker/livekit/livekit.yaml)
LIVEKIT_URL=http://127.0.0.1:7880
# Optional override. In dev, omitted LIVEKIT_PUBLIC_URL is ws://<preferred-lan-ip>:7880.
# LIVEKIT_PUBLIC_URL=ws://192.168.1.50:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_WEBHOOK_SECRET=devsecret
CALL_EMPTY_GRACE_MS=45000

# S3-compatible object store (MinIO locally). Egress writes per-track audio here.
OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
# Optional. Omit in dev to advertise http://<preferred-lan-ip>:9000 in presigned URLs.
# OBJECT_STORE_PUBLIC_ENDPOINT=http://192.168.1.50:9000
OBJECT_STORE_BUCKET=arcana-recordings
OBJECT_STORE_ACCESS_KEY=minio
OBJECT_STORE_SECRET_KEY=minio12345
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_FORCE_PATH_STYLE=true

# LiveKit Track Egress websocket ingest (500ms WAV fragments).
EGRESS_INGEST_URL=ws://127.0.0.1:3000/internal/egress
EGRESS_INGEST_SECRET=dev-egress-secret
