# LAN IPs are auto-detected from Metro (--lan) and the server's NICs.
# Leave these unset for phone + LAN web. Restart Metro after a network change.
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000
# EXPO_PUBLIC_WS_URL=ws://192.168.1.50:3000/ws
# EXPO_PUBLIC_LIVEKIT_URL=ws://192.168.1.50:7880

# Same-machine only (optional override if Metro inference is wrong):
# EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
# EXPO_PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880
